{
  "compilerOptions": {
    "allowJs": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "dist",
    "strict": true,
    "target": "ES2020",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts"
  ]
}